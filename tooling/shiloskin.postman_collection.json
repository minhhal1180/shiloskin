      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/listings?status=ACTIVE",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('active status filter',()=>pm.expect(pm.response.json().items.every(i=>i.status==='ACTIVE')).true);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create listing from CSV data",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/listings",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"item_id\": \"{{item_id}}\", \"price\": \"{{price}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.environment.set('listingId',pm.response.json().id);",
              "pm.test('listing id assigned',()=>pm.expect(pm.response.json().id).a('number'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Find own listing",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/listings?mine=1",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('created listing exists',()=>{const id=Number(pm.environment.get('listingId'));pm.expect(pm.response.json().items.some(i=>i.id===id)).true;});"
            ]
          }
        }
      ]
    },
    {
      "name": "Cancel own active listing",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/listings/{{listingId}}/cancel",
