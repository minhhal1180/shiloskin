        }
      ]
    },
    {
      "name": "Cancelled listing persists",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/listings?mine=1",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('cancelled state',()=>pm.expect(pm.response.json().items.find(i=>i.id===Number(pm.environment.get('listingId'))).status).eql('CANCELLED'));"
            ]
          }
        }
      ]
    },
