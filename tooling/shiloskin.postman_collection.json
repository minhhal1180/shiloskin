{
  "info": {
    "name": "ShiloSkin — functional API test with three CSV datasets",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Actual tests on isolated local copy of the AI-assisted ShiloSkin build. Tester: Bui Xuan Minh 23110193, owner: Nguyen Tu Lan 23110306. Not a blind assessment of an independently developed system."
  },
  "item": [
    {
      "name": "Reject unauthenticated session",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/me",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401',()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login member",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('login success',()=>pm.expect(pm.response.json().ok).true);"
            ]
          }
        }
      ]
    },
    {
      "name": "Identity and CSRF",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/me",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.environment.set('csrf',pm.response.json().csrf);",
              "pm.test('member role',()=>pm.expect(pm.response.json().user.role).eql('MEMBER'));"
            ]
          }
        }
      ]
    },
    {
