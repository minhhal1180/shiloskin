        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('catalog nonempty',()=>pm.expect(pm.response.json().items.length).above(0));"
            ]
          }
        }
      ]
    },
